# Optional. Without a key the app reads FRED's public CSV download endpoint (same data, no SLA).
# With a key it uses the official FRED API. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Copy this file to .env.local and fill in the value; .env.local is git-ignored.
FRED_API_KEY=

# Set to 1 to skip FRED entirely and run on the simulated series.
FRED_DISABLED=

# Set to 1 to skip Yahoo Finance and run the ticker tape and price chart on simulated prices.
YAHOO_DISABLED=

# Twelve Data (https://twelvedata.com) — ETF and FX prices. Needed on cloud servers, where Yahoo
# blocks requests. Free "Basic" plan: 8 credits/minute, 800/day; the app budgets 760 of them.
TWELVE_DATA_API_KEY=
# Raise these only on a paid plan.
TWELVE_DATA_CREDITS_PER_MINUTE=
TWELVE_DATA_DAILY_CREDITS=
